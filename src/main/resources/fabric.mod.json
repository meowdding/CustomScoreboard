{
    "schemaVersion": 1,
    "id": "customscoreboard",
    "version": "${version}",
    "name": "Custom Scoreboard",
    "license": "",
    "icon": "assets/customscoreboard/icon.png",
    "environment": "client",
    "mixins": [
        "customscoreboard.mixins.json"
    ],
    "entrypoints": {
        "client": [
            {
                "value": "me.owdding.customscoreboard.CustomScoreboardMod",
                "adapter": "kotlin"
            }
        ]
    },
    "depends": {
        "fabricloader": ">=0.16.10",
        "minecraft": "${minecraft_range}",
        "fabric-api": "*",
        "fabric-language-kotlin": ">=${fabric_lang_kotlin}",
        "resourcefullib": ">=${rlib}",
        "olympus": ">=${olympus}",
        "skyblock-api": ">=${sbapi}",
        "meowdding-lib": ">=${mlib}",
        "resourcefulconfigkt": ">=${rconfigkt}",
        "resourcefulconfig": ">=${rconfig}"
    },
    "breaks": {
        "scoreboard-overhaul": "<1.5.1"
    }
}
